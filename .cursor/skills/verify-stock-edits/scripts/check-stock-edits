#!/usr/bin/env bash
# Model-checks .cursor/skills/verify-stock-edits/model/StockEdits.tla with TLC.
# The model's guard constants are read from the code, so removing a guard in
# the code turns its constant FALSE and the check shows what that breaks.
set -euo pipefail

TLA_VERSION=1.8.0
TLA_SHA256=d15655eeaff4b3f7b3d65c46b838bc0f35d131b2ef4b1e473689b62c98d4726f

# Properties the current code is known to break. The check expects each one
# to fail. Remove a name here once the code is fixed and the check passes it.
KNOWN_FINDINGS=()

PROPERTIES=(NoLostUpdate StockNeverNegative AgentNeverStoresOverMax
  EditPageNeverStoresOverMax MoveKeepsTotal LocationDeleteKeepsStock
  StaleSaveNeverCrashes)

ONLY=
if [[ ${1:-} == --only ]]; then
  ONLY=${2:?usage: check-stock-edits [--only PROPERTY]}
fi

ROOT=$(git rev-parse --show-toplevel)
SKILL_DIR="$ROOT/.cursor/skills/verify-stock-edits"
OUT="$ROOT/tmp/verify-stock-edits"
WORKERS=${TLC_WORKERS:-auto}

die() { echo "error: $*" >&2; exit 2; }

command -v java >/dev/null || die "java not found. Install a JDK 11 or newer (for example: mise use java@temurin-21)."
command -v perl >/dev/null || die "perl not found."

JAR=${TLA2TOOLS_JAR:-"${XDG_CACHE_HOME:-$HOME/.cache}/pinventory/tla2tools-$TLA_VERSION.jar"}
if [[ ! -f "$JAR" ]]; then
  mkdir -p "$(dirname "$JAR")"
  echo "downloading tla2tools.jar $TLA_VERSION to $JAR"
  curl -fsSL -o "$JAR.part" "https://github.com/tlaplus/tlaplus/releases/download/v$TLA_VERSION/tla2tools.jar"
  mv "$JAR.part" "$JAR"
fi
if command -v sha256sum >/dev/null; then
  sum=$(sha256sum "$JAR" | cut -d' ' -f1)
else
  sum=$(shasum -a 256 "$JAR" | cut -d' ' -f1)
fi
[[ "$sum" == "$TLA_SHA256" ]] || die "$JAR has sha256 $sum, expected $TLA_SHA256. Delete it and rerun."

# anchor FILE REGEX: TRUE when REGEX (Perl, /s) matches FILE.
anchor() {
  perl -0777 -ne "exit(/$2/s ? 0 : 1)" "$ROOT/$1" && echo TRUE || echo FALSE
}

# One regex per model constant. A FALSE means the guard is gone from the code,
# or the code moved and the regex needs updating. SKILL.md says how to tell.
ITEMS=lib/pinventory/items.ex
FLAG_NAMES=()
flag() { FLAG_NAMES+=("$1"); printf -v "FLAG_$1" %s "$2"; }
stock_section=$(anchor lib/pinventory/items/item.ex 'stock: \{:item_locations, :stock_version\}')
stock_edited=$(anchor $ITEMS 'defp edited_sections\((?:(?!\n  defp? ).)*?:stock -> stock_changed\?')
locks=$(anchor $ITEMS 'defp save_item\((?:(?!\n  defp? ).)*?lock_sections\(changeset, sections\).*?defp lock_sections\((?:(?!\n  defp? ).)*?\|> Ecto\.Changeset\.optimistic_lock\(field\)')
if [[ $stock_section == TRUE && $stock_edited == TRUE && $locks == TRUE ]]; then flag StockLock TRUE; else flag StockLock FALSE; fi
flag ForceVersionBump "$(anchor $ITEMS 'defp lock_sections\((?:(?!\n  defp? ).)*?\|> Ecto\.Changeset\.force_change\(field, Map\.fetch!\(changeset\.data, field\)\)')"
flag SyncOnlyChangedStock "$(anchor $ITEMS 'defp save_item\((?:(?!\n  defp? ).)*?if stock_changed\?, do: sync_stock\(repo, updated\.id, desired\), else: \{:ok, before_stock\}')"
in_tx=$(anchor $ITEMS 'defp write_stock\([^)]*\) do\s*Repo\.transact\(fn ->\s*with \{:ok, item\} <- fetch_item_for_stock\(item_id\),')
immediate=$(anchor config/config.exs 'config :pinventory, Pinventory\.Repo, default_transaction_mode: :immediate')
if [[ $in_tx == TRUE && $immediate == TRUE ]]; then flag AgentReadsInTx TRUE; else flag AgentReadsInTx FALSE; fi
flag ChangeStockChecksBelowZero "$(anchor $ITEMS 'defp changed_count\((?:(?!\n  defp? ).)*?new < 0 -> \{:error, \{:below_zero, current\}\}')"
flag ChangeStockChecksMax "$(anchor $ITEMS 'defp changed_count\((?:(?!\n  defp? ).)*?new > DraftStock\.max_quantity\(\) -> \{:error, :too_many\}')"
flag MoveStockChecksMax "$(anchor $ITEMS 'defp moved_counts\((?:(?!\n  defp? ).)*?to \+ quantity > DraftStock\.max_quantity\(\) -> \{:error, :too_many\}')"
flag MoveStockChecksEnough "$(anchor $ITEMS 'defp moved_counts\((?:(?!\n  defp? ).)*?quantity > from -> \{:error, \{:not_enough, from\}\}')"
validates=$(anchor lib/pinventory/items/item_location.ex 'validate_number\(:quantity,\s*greater_than: 0[,)]')
db_check=$(anchor priv/repo/migrations/20260223042150_create_locations_and_item_locations.exs 'check: %\{name: "quantity_must_be_positive", expr: "quantity > 0"\}')
if [[ $validates == TRUE || $db_check == TRUE ]]; then flag QuantityMustBePositive TRUE; else flag QuantityMustBePositive FALSE; fi
flag SaveChecksMax "$(anchor lib/pinventory/items/item_location.ex 'validate_number\(:quantity,(?:(?!\n    \|>).)*?less_than_or_equal_to: DraftStock\.max_quantity\(\)')"
flag AdjustCapsAtMax "$(anchor lib/pinventory/items/draft_stock.ex 'def put\((?:(?!\n  def ).)*?max_quantity')"
flag LocationDeleteChecksStock "$(anchor lib/pinventory/locations.ex 'def delete\((?:(?!\n  def ).)*?Multi\.run\(:empty\?, fn repo, _ ->\s*if location_has_items\?\(repo, location\.id\) do\s*\{:error, :location_has_items\}')"
flag StaleReloadRaises "$(anchor lib/pinventory_web/live/edit_item_live.ex '\{:error, :stale\} ->(?:(?!\n      \{:error).)*?Items\.get_item!\(')"

echo "code facts (model constants):"
for k in "${FLAG_NAMES[@]}"; do
  v="FLAG_$k"; printf '  %-26s %s\n' "$k" "${!v}"
done

rm -rf "$OUT" && mkdir -p "$OUT"
cp "$SKILL_DIR/model/StockEdits.tla" "$OUT/"

write_cfg() {
  local name=$1; shift
  {
    echo "SPECIFICATION Spec"
    echo "CONSTANTS"
    echo "  Pages = {p1, p2}"
    echo "  Locs = {l1, l2}"
    echo "  Max = 1"
    echo "  MaxWrites = 2"
    for k in "${FLAG_NAMES[@]}"; do v="FLAG_$k"; echo "  $k = ${!v}"; done
    echo "CONSTRAINT StateBound"
    echo "SYMMETRY Symmetry"
    echo "CHECK_DEADLOCK FALSE"
    echo "INVARIANT TypeOK $*"
  } >"$OUT/$name.cfg"
}

# run NAME INVARIANTS...: prints the violated invariant, "none", or "tool-error".
run() {
  local name=$1; shift
  write_cfg "$name" "$@"
  (cd "$OUT" && java -XX:+UseParallelGC -cp "$JAR" tlc2.TLC -config "$name.cfg" \
    -workers "$WORKERS" -metadir "$OUT/meta-$name" -nowarning StockEdits.tla) >"$OUT/$name.out" 2>&1 || true
  if grep -q '^Model checking completed. No error has been found.' "$OUT/$name.out"; then
    echo none
  elif v=$(grep -oE '^Error: Invariant [A-Za-z]+ is violated' "$OUT/$name.out" | awk '{print $3}'); [[ -n $v ]]; then
    echo "$v"
  else
    echo tool-error
  fi
}

is_known() { local x; for x in "${KNOWN_FINDINGS[@]}"; do [[ $x == "$1" ]] && return 0; done; return 1; }

expected=()
for p in "${PROPERTIES[@]}"; do is_known "$p" || expected+=("$p"); done
if [[ -n $ONLY ]]; then
  expected=("$ONLY")
  KNOWN_FINDINGS=()
fi

status=0
start=$SECONDS
result=$(run main "${expected[@]}")
case $result in
  none) echo "PASS  ${expected[*]}" ;;
  tool-error) echo "TOOL ERROR, see $OUT/main.out"; status=2 ;;
  *) echo "FAIL  $result (counterexample: $OUT/main.out)"; status=1 ;;
esac

for f in "${KNOWN_FINDINGS[@]}"; do
  r=$(run "$f" "$f")
  case $r in
    "$f") echo "KNOWN FINDING still present: $f (counterexample: $OUT/$f.out)" ;;
    none) echo "FIXED? $f now passes. Confirm the fix with a test, then remove it from KNOWN_FINDINGS and the findings in SKILL.md."; status=1 ;;
    tool-error) echo "TOOL ERROR, see $OUT/$f.out"; status=2 ;;
    *) echo "FAIL  $r while checking $f (counterexample: $OUT/$f.out)"; [[ $status == 0 ]] && status=1 ;;
  esac
done
echo "model checked in $((SECONDS - start))s"

# Coverage drift: covered code changed since the sync commit in SKILL.md.
sync=$(sed -n 's/^Sync commit: `\([0-9a-f]*\)`.*/\1/p' "$SKILL_DIR/SKILL.md")
covered=$(sed -n 's/^- `\([^`]*\)`:.*/\1/p' "$SKILL_DIR/SKILL.md" | sort -u)
if [[ -n $sync ]] && git -C "$ROOT" cat-file -e "$sync^{commit}" 2>/dev/null; then
  # shellcheck disable=SC2086
  drift=$(cd "$ROOT" && git diff --name-only "$sync" -- $covered)
  if [[ -n $drift ]]; then
    echo "covered code changed since sync commit $sync, so recheck the model against it:"
    echo "$drift" | sed 's/^/  /'
  fi
else
  echo "warning: sync commit '$sync' from SKILL.md is not in this clone; cannot check coverage drift."
fi

exit $status
